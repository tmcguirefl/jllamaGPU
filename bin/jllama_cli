#!/usr/bin/env bash
# Convenience wrapper: run repo-root jllama_cli.ijs (shebang → jconsole).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLI="$ROOT/jllama_cli.ijs"
if [[ ! -x "$CLI" ]]; then
  echo "jllama_cli: missing or not executable: $CLI" >&2
  exit 127
fi
# Blank line so jconsole does not wait on "Press ENTER to inspect" after errors.
printf '\n' | exec "$CLI" "$@"
