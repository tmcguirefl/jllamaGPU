#!/usr/bin/env bash
# jllama_cli - thin shell wrapper around jconsole + jllama_cli.ijs
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JCONSOLE="${JCONSOLE:-/Applications/j9.8/bin/jconsole}"

if [[ ! -x "$JCONSOLE" ]]; then
  echo "jllama_cli: jconsole not found or not executable: $JCONSOLE" >&2
  echo "Set JCONSOLE to your J 9.8 jconsole path." >&2
  exit 127
fi

# Feed a blank line so jconsole does not wait for "Press ENTER to inspect" on errors.
# main_jllamacli_ calls 2!:55 and exits the process.
printf '\n' | exec "$JCONSOLE" "$ROOT/jllama_cli.ijs" "$@"
